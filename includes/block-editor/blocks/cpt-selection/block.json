{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yohdev/cpt-selection",
	"version": "0.2.0",
	"title": "YohDev - Post Selection Block",
	"category": "yohdev-blocks-category",
	"description": "Displays a dynamic list of the most recent posts.",
	"icon": "list-view",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": "h1"
		},
		"titleColor": {
			"type": "string",
			"default": "black"
		},
		"titleSize": {
			"type": "number",
			"default": 65
		},
		"body": {
			"type": "string",
			"source": "html",
			"selector": "p"
		},
		"backgroundColor": {
			"type": "string",
			"default": "none"
		},
		"radio": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"align": [ "wide", "full" ]
	},
	"example": {},
	"textdomain": "yohdev-blocks",
	"editorScript": "file:../../../../build/cpt-selection.js",
	"editorStyle": "file:../../../../build/cpt-selection.css",
	"style": "file:../../../../build/style-cpt-selection.css",
	"render": "file:./render.php"
}
