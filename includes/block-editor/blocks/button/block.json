{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yohdev/button",
	"version": "0.2.0",
	"title": "YohDev - Button",
	"category": "yohdev-blocks-category",
	"icon": "button",
	"description": "A styled call-to-action button with a customizable label and link.",
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"fontWeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"title": {
			"type": "string",
			"source": "attribute",
			"selector": "a",
			"attribute": "title"
		},
		"url": {
			"type": "string",
			"source": "attribute",
			"selector": "a",
			"attribute": "href"
		},
		"text": {
			"type": "array",
			"source": "children",
			"selector": "a"
		},
		"className": {
			"type": "string"
		},
		"radio": {
			"type": "string",
			"default": "default"
		}
	},
	"example": {},
	"textdomain": "yohdev-blocks",
	"editorScript": "file:../../../../build/button.js",
	"editorStyle": "file:../../../../build/button.css",
	"style": "file:../../../../build/style-button.css"
}
