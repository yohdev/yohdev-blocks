{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yohdev/capable-card",
	"version": "0.2.0",
	"title": "YohDev - Capable Card",
	"category": "yohdev-blocks-category",
	"description": "A capability card with a title, body copy and configurable colors.",
	"icon": "id",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": "h3"
		},
		"titleColor": {
			"type": "string",
			"default": "white"
		},
		"titleSize": {
			"type": "number",
			"default": 25
		},
		"body": {
			"type": "string",
			"source": "html",
			"selector": "p"
		},
		"bodyColor": {
			"type": "string",
			"default": "white"
		},
		"backgroundColor": {
			"type": "string",
			"default": "black"
		},
		"borderColor": {
			"type": "string",
			"default": "#9185de"
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"example": {},
	"textdomain": "yohdev-blocks",
	"editorScript": "file:../../../../build/capable-card.js",
	"editorStyle": "file:../../../../build/capable-card.css",
	"style": "file:../../../../build/style-capable-card.css"
}
