{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yohdev/card-repeater",
	"version": "0.2.0",
	"title": "YohDev - Card Repeater Section",
	"category": "yohdev-blocks-category",
	"description": "A section that repeats cards in a configurable grid layout.",
	"icon": "grid-view",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": "h1"
		},
		"titleColor": {
			"type": "string",
			"default": "black"
		},
		"titleSize": {
			"type": "number",
			"default": 65
		},
		"body": {
			"type": "string",
			"source": "html",
			"selector": "p"
		},
		"bodyColor": {
			"type": "string",
			"default": "black"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"overlayColor": {
			"type": "string",
			"default": "none"
		},
		"radio": {
			"type": "string",
			"default": "3X1"
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"align": [ "wide", "full" ]
	},
	"example": {},
	"textdomain": "yohdev-blocks",
	"editorScript": "file:../../../../build/card-repeater.js",
	"editorStyle": "file:../../../../build/card-repeater.css",
	"style": "file:../../../../build/style-card-repeater.css"
}
