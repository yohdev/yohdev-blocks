{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yohdev/single-card",
	"version": "0.2.0",
	"title": "YohDev - Single Card",
	"category": "yohdev-blocks-category",
	"description": "A single repeatable card with an optional featured image.",
	"icon": "id-alt",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": "h2"
		},
		"titleColor": {
			"type": "string",
			"default": "black"
		},
		"body": {
			"type": "string",
			"source": "html",
			"selector": "p"
		},
		"bodyColor": {
			"type": "string",
			"default": "black"
		},
		"featImage": {
			"type": "string",
			"default": null
		},
		"radio": {
			"type": "string",
			"default": "hide"
		},
		"backgroundColor": {
			"type": "string",
			"default": "white"
		},
		"alignment": {
			"type": "string",
			"default": "none"
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"example": {},
	"textdomain": "yohdev-blocks",
	"editorScript": "file:../../../../build/single-card.js",
	"editorStyle": "file:../../../../build/single-card.css",
	"style": "file:../../../../build/style-single-card.css"
}
