{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yohdev/cta",
	"version": "0.2.0",
	"title": "YohDev - Call To Action",
	"category": "yohdev-blocks-category",
	"description": "A call-to-action section with a heading, body copy and alignment options.",
	"icon": "megaphone",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": "h1"
		},
		"titleColor": {
			"type": "string",
			"default": "black"
		},
		"titleSize": {
			"type": "number",
			"default": 65
		},
		"body": {
			"type": "string",
			"source": "html",
			"selector": "p"
		},
		"backgroundColor": {
			"type": "string",
			"default": "none"
		},
		"alignment": {
			"type": "string",
			"default": "center"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"align": [ "wide", "full" ]
	},
	"example": {},
	"textdomain": "yohdev-blocks",
	"editorScript": "file:../../../../build/cta.js",
	"editorStyle": "file:../../../../build/cta.css",
	"style": "file:../../../../build/style-cta.css"
}
